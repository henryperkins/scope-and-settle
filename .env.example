# Copy to .env.local at the repository root and fill locally. Never commit secrets.
# Use Node 24. Real PayPal environments are rejected at startup.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX_MERCHANT_EMAIL=
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_WEBHOOK_ID=

# Figma token scope: file_comments:read. The backend allowlists this file key.
FIGMA_PERSONAL_ACCESS_TOKEN=
FIGMA_FILE_KEY=
FIGMA_FILE_URL=

# Server-side Baseten Model API. OpenAI/AI_API_KEY values are never used.
BASETEN_API_KEY=
AI_PROVIDER=baseten
AI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017-Fast
AI_REASONING_EFFORT=max
# Cap per persistent database, maximum $25. For a second deployment, allocate
# only the remaining development budget and stop spending on the first instance.
AI_BUDGET_USD=25

HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
# SCOPE_SETTLE_DATA_DIR is a process environment variable. Default: app/data.
# The Google Cloud container sets it to /var/data on its persistent disk.
# The plugin build reads PUBLIC_BASE_URL from the shell, not this file.

# Enable reviewed Figma posting only with a token granted file_comments:write.
# Read-only deployments need only file_comments:read.
FIGMA_COMMENT_POSTING_ENABLED=false

# Custom Figma agent connector. Disabled by default: while false, the designer page
# cannot issue connector credentials and every connector credential is refused.
# Credentials are issued only from the authenticated designer page, never from config.
MCP_CONNECTOR_ENABLED=false
# The connector endpoint is POST /mcp on PUBLIC_BASE_URL; its Host must match that URL exactly.
# Exact browser origins allowed to call /mcp, comma-separated (for example https://www.figma.com).
# Empty by default: any supplied Origin is refused; requests without Origin still need the bearer.
MCP_ALLOWED_ORIGINS=
# Peer IP addresses of a reverse proxy or tunnel whose X-Forwarded-Host/Proto may be trusted.
# Empty by default: forwarded headers are ignored and the direct Host must match PUBLIC_BASE_URL.
MCP_TRUSTED_PROXIES=
