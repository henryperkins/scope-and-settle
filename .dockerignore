app/src/backend/**
!app/src/backend/*.ts
!app/src/shared/
app/src/shared/**
!app/src/shared/*.ts
!app/web/
app/web/**
!app/web/*.html
!app/web/*.js
!app/web/*.css
!app/plugin/
app/plugin/**
!app/plugin/code.ts
!app/plugin/manifest.json
!app/plugin/tsconfig.json
!app/scripts/
app/scripts/**
!app/scripts/*.mjs
!app/tests/
app/tests/**
!app/tests/*.mjs
!fixtures/
fixtures/**
!fixtures/scope-judgment-cases.json
