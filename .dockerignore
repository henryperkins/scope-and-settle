# Explicit build context: local credentials, databases and evidence never enter it.
**
!Dockerfile
!JUDGING.md
# Public configuration template (empty secrets) read by the build-stage tests; never .env.local.
!.env.example
!deploy/
deploy/**
!deploy/gcp/
deploy/gcp/**
!deploy/gcp/webhook-lookup.mjs
!app/
app/**
!app/package.json
!app/pnpm-lock.yaml
!app/tsconfig.json
!app/build-plugin.mjs
!app/src/
app/src/**
!app/src/backend/
app/src/backend/**
!app/src/backend/*.ts
!app/src/shared/
app/src/shared/**
!app/src/shared/*.ts
!app/web/
app/web/**
!app/web/*.html
!app/web/*.js
!app/web/*.css
!app/plugin/
app/plugin/**
!app/plugin/code.ts
!app/plugin/status-card.ts
!app/plugin/delivery.ts
!app/plugin/manifest.json
!app/plugin/tsconfig.json
!app/scripts/
app/scripts/**
!app/scripts/*.mjs
!app/tests/
app/tests/**
!app/tests/*.mjs
# Synthetic test inputs: a child-process helper and a schema-only SQL fixture.
!app/tests/fixtures/
app/tests/fixtures/**
!app/tests/fixtures/*.mjs
!app/tests/fixtures/*.sql
!fixtures/
fixtures/**
!fixtures/scope-judgment-cases.json
!fixtures/scope-held-out-cases.json
!fixtures/scope-baseline-cases.json
!docs/
docs/**
!docs/verification/
docs/verification/**
!docs/verification/scope-evaluation-contract.json
!docs/verification/scope-evaluation-case-notes.json
